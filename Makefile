# BSM-64 Milestones 001-002 build.
# Tools: make + system cc only. No external libraries.
# Commands:
#   make            build the VM, the assembler, the fixture
#                   generator, generate fixtures (including the
#                   hand-authored .asm fixtures assembled to
#                   asm-*.pqrb), and build the verification harness
#   make check      build everything and run the harness
#   make clean      remove build outputs (fixtures/*.pqrb are
#                   regenerated by make; they are checked-in
#                   generated files, not build scratch)
CC ?= cc
CFLAGS ?= -std=c11 -Wall -Wextra -O2
CPPFLAGS += -Imachine -Imachine/decoder -Imachine/registers -Imachine/memory

VM_SRCS = machine/vm.c machine/bsm_sha256.c \
          machine/decoder/bsm_decoder.c \
          machine/registers/bsm_registers.c \
          machine/memory/bsm_memory.c
GEN_SRCS = fixtures/gen.c machine/bsm_sha256.c \
           machine/decoder/bsm_decoder.c
ASM_SRCS = machine/assembler/bsmasm.c machine/bsm_sha256.c \
           machine/decoder/bsm_decoder.c
ASM_FIXTURES = fixtures/asm-arith.pqrb fixtures/asm-loop.pqrb \
               fixtures/asm-callret.pqrb fixtures/asm-memory.pqrb

all: build/bsm64 build/bsmasm build/gen fixtures asm-fixtures build/harness

build/bsm64: $(VM_SRCS)
	mkdir -p build
	$(CC) $(CPPFLAGS) $(CFLAGS) -o $@ $(VM_SRCS)

build/bsmasm: $(ASM_SRCS)
	mkdir -p build
	$(CC) $(CPPFLAGS) $(CFLAGS) -o $@ $(ASM_SRCS)

build/gen: $(GEN_SRCS)
	mkdir -p build
	$(CC) $(CPPFLAGS) $(CFLAGS) -o $@ $(GEN_SRCS)

fixtures: build/gen
	./build/gen fixtures

asm-fixtures: $(ASM_FIXTURES)

fixtures/asm-%.pqrb: fixtures/%.asm build/bsmasm
	./build/bsmasm $< $@

build/harness: verification/harness.c
	mkdir -p build
	$(CC) $(CFLAGS) -o $@ verification/harness.c

check: all
	./build/harness ./build/bsm64 fixtures ./build/bsmasm

clean:
	rm -rf build

.PHONY: all fixtures check clean
